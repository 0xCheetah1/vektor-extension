AGENT_PROVIDER=deepseek
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_ENDPOINT=https://api.deepseek.com/chat/completions

# Logo image generation provider: pollinations (default, no key), orbio, clawrouter, or minimax.
# clawrouter uses a funded BlockRun wallet; falls back to pollinations if payment fails.
IMAGE_PROVIDER=pollinations
IMAGE_MODEL=openai/gpt-image-1
CLAWROUTER_URL=http://127.0.0.1:8402
# MINIMAX_API_KEY=your_minimax_api_key

# Orbio (OpenAI-compatible). Set ORBIO_BASE_URL, or a full ORBIO_ENDPOINT.
# AGENT_PROVIDER=orbio
# ORBIO_BASE_URL=https://your-orbio-endpoint.example/v1
# ORBIO_MODEL=your-chat-model
# ORBIO_ENDPOINT=https://your-orbio-endpoint.example/v1/chat/completions
# ORBIO_API_KEY=your_orbio_api_key
# ORBIO_IMAGE_ENDPOINT=https://your-orbio-endpoint.example/v1/images/generations
# ORBIO_IMAGE_MODEL=google/gemini-3.1-flash-image
# ORBIO_IMAGE_SIZE=1024x1024

# Public logo uploads for launchpad metadata.
# UPLOAD_DIR defaults to server/uploads.
# ASSET_PUBLIC_BASE_URL must be a public HTTPS URL that maps to /assets on the server.
# If the local URL is not externally reachable, the server mirrors <=1MB images to the public IPFS upload gateway and returns that URL.
ASSET_PUBLIC_BASE_URL=https://thecheetah11.com/vektor-agent/assets
