{
  "manifest_version": 2,
  "name": "VEKTOR Meme Launcher",
  "description": "Spot viral X posts, generate meme token metadata, and prepare token launches from an overlay.",
  "version": "0.1.0",
  "permissions": ["activeTab", "storage", "https://x.com/*", "https://twitter.com/*", "http://localhost:8787/*"],
  "background": {
    "scripts": ["src/background.js"]
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": ["src/page-wallet.js"],
  "browser_action": {
    "default_popup": "src/popup.html",
    "default_title": "VEKTOR"
  },
  "options_ui": {
    "page": "src/dashboard.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "vektor-meme-launcher@vektor.local",
      "strict_min_version": "109.0"
    }
  }
}
